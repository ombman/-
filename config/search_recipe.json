{
  "_readme": [
    "このファイルは『売買物件検索』の自動操作手順です。プログラムを書き換えずに、",
    "ここ（JSON）を編集するだけで手順や特定条件を調整できます。",
    "",
    "各ステップの意味:",
    "  id                : ステップの識別名（スクショのファイル名にも使われます）",
    "  description       : 何をするかの説明（ログに出ます）",
    "  action            : 操作の種類。click / fill / select / choose / check / scroll /",
    "                      wait_for / wait_ms / verify / screenshot / dump_html",
    "  targets           : 対象の特定候補。上から順に試し、最初に見つかったものを使います。",
    "                      by = label / role / text / placeholder / name / id / css / xpath",
    "  value             : fill(入力) / select / choose で使う値",
    "  verify            : 操作後の確認条件（contains / visible_targets / not_contains）",
    "  scroll_into_view  : true にすると対象が画面内に来るまでスクロールします",
    "  optional          : true にすると、このステップが失敗しても止めずに次へ進みます",
    "  coordinate_fallback : [x, y]。HTMLで特定できない時だけ使う座標（補助手段）",
    "",
    "★沿線の入力方式（重要）:",
    "  REINSの『入力ガイド』ポップアップは使わず、沿線1〜3の入力欄へ駅名を直接入力します。",
    "  各沿線の見出し（沿線1/沿線2/沿線3）を起点に、続く入力欄をXPathで指定します:",
    "    見出しの後 input[1]=沿線名, input[2]=駅名(始), input[3]=駅名(終), input[4]=駅から徒歩,",
    "    select[1]=徒歩の単位。",
    "  沿線名は『完全一致』で誤ると0件になるため入力せず、駅名（完全一致・連絡駅も対象）で特定します。",
    "  沿線3の終駅は、ご指示『香露園』を実在駅『香櫨園(こうろえん)』と解釈しています（違えば value を変更）。"
  ],

  "steps": [
    { "id": "open_baibai_search",
      "description": "「売買物件検索」を探してクリックする",
      "action": "click",
      "targets": [
        { "by": "role", "value": "売買物件検索", "options": { "role": "link" } },
        { "by": "text", "value": "売買物件検索" }
      ],
      "verify": { "contains": "物件種別" }
    },
    { "id": "select_bukken_shubetsu1_baimansion",
      "description": "「物件種別1」から「売マンション」を選択する",
      "action": "choose",
      "value": "売マンション",
      "targets": [
        { "by": "css", "value": "select:has(option:text-is('売マンション'))" },
        { "by": "label", "value": "物件種別1" },
        { "by": "name", "value": "bukkenShubetsu1" },
        { "by": "css", "value": "select[name*='shubetsu']" }
      ],
      "note": "『売マンション』という選択肢を持つ<select>を直接狙う。.first で物件種別1を選ぶ。"
    },

    { "id": "ensen1_senro", "description": "沿線1 沿線名を入力（駅名がある場合は必須・完全一致）", "action": "fill", "value": "東海道線",
      "scroll_into_view": true,
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[1]/preceding::input[1]" }
      ],
      "note": "駅名ラベルの直前のinput=沿線名。正式表記が違えばvalueを変更（完全一致のため）。" },
    { "id": "ensen1_start_eki", "description": "沿線1 始駅「甲子園口」を入力", "action": "fill", "value": "甲子園口",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[1]/following::input[1]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線1']/following::input[2]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線１']/following::input[2]" }
      ],
      "note": "『駅名』ラベルは沿線欄だけにある目印。(駅名ラベル1つ目)の次のinput[1]=始駅。沿線名は完全一致リスク回避のため未入力。" },
    { "id": "ensen1_end_eki", "description": "沿線1 終駅「さくら夙川」を入力", "action": "fill", "value": "さくら夙川",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[1]/following::input[2]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線1']/following::input[3]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線１']/following::input[3]" }
      ] },
    { "id": "ensen1_walk", "description": "沿線1 駅から徒歩に 10 を入力", "action": "fill", "value": "10",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[1]/following::input[3]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線1']/following::input[4]" }
      ] },
    { "id": "ensen1_walk_unit", "description": "沿線1 徒歩の単位を「分」に", "action": "select", "value": "分", "optional": true,
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[1]/following::select[1]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線1']/following::select[1]" }
      ],
      "note": "単位プルダウン。既定が分なら失敗しても続行(optional)。" },

    { "id": "ensen2_senro", "description": "沿線2 沿線名を入力（駅名がある場合は必須・完全一致）", "action": "fill", "value": "阪急神戸線",
      "scroll_into_view": true,
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[2]/preceding::input[1]" }
      ] },
    { "id": "ensen2_start_eki", "description": "沿線2 始駅「西宮北口」を入力", "action": "fill", "value": "西宮北口",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[2]/following::input[1]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線2']/following::input[2]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線２']/following::input[2]" }
      ] },
    { "id": "ensen2_end_eki", "description": "沿線2 終駅「夙川」を入力", "action": "fill", "value": "夙川",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[2]/following::input[2]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線2']/following::input[3]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線２']/following::input[3]" }
      ] },
    { "id": "ensen2_walk", "description": "沿線2 駅から徒歩に 10 を入力", "action": "fill", "value": "10",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[2]/following::input[3]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線2']/following::input[4]" }
      ] },
    { "id": "ensen2_walk_unit", "description": "沿線2 徒歩の単位を「分」に", "action": "select", "value": "分", "optional": true,
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[2]/following::select[1]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線2']/following::select[1]" }
      ] },

    { "id": "ensen3_senro", "description": "沿線3 沿線名を入力（駅名がある場合は必須・完全一致）", "action": "fill", "value": "阪神本線",
      "scroll_into_view": true,
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[3]/preceding::input[1]" }
      ] },
    { "id": "ensen3_start_eki", "description": "沿線3 始駅「甲子園」を入力", "action": "fill", "value": "甲子園",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[3]/following::input[1]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線3']/following::input[2]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線３']/following::input[2]" }
      ] },
    { "id": "ensen3_end_eki", "description": "沿線3 終駅「香櫨園」を入力", "action": "fill", "value": "香櫨園",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[3]/following::input[2]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線3']/following::input[3]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線３']/following::input[3]" }
      ],
      "note": "ご指示『香露園』は実在駅『香櫨園』と解釈。違えば value を変更。" },
    { "id": "ensen3_walk", "description": "沿線3 駅から徒歩に 10 を入力", "action": "fill", "value": "10",
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[3]/following::input[3]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線3']/following::input[4]" }
      ] },
    { "id": "ensen3_walk_unit", "description": "沿線3 徒歩の単位を「分」に", "action": "select", "value": "分", "optional": true,
      "targets": [
        { "by": "xpath", "value": "(//*[contains(text(),'駅名')])[3]/following::select[1]" },
        { "by": "xpath", "value": "//*[normalize-space()='沿線3']/following::select[1]" }
      ] },

    { "id": "dump_after_ensen", "description": "（診断）沿線入力後の画面HTMLを保存（価格欄の構造把握用）", "action": "dump_html", "optional": true },
    { "id": "scroll_to_price", "description": "価格欄まで下方向にスクロール", "action": "scroll", "value": 500 },
    { "id": "price_min", "description": "価格の下限に 3000（万円）を入力", "action": "fill", "value": "3000",
      "scroll_into_view": true,
      "targets": [
        { "by": "xpath", "value": "//*[normalize-space()='価格']/following::input[1]" },
        { "by": "xpath", "value": "//*[normalize-space()='価格(万円)']/following::input[1]" },
        { "by": "name", "value": "priceLow" },
        { "by": "name", "value": "priceMin" }
      ],
      "note": "見つからなければ手前のdump_after_ensenのHTMLで価格欄の構造を確認して調整。ここで止まっても未指定検索を防ぐため必須(非optional)。" },
    { "id": "price_max", "description": "価格の上限に 7000（万円）を入力", "action": "fill", "value": "7000",
      "targets": [
        { "by": "xpath", "value": "//*[normalize-space()='価格']/following::input[2]" },
        { "by": "xpath", "value": "//*[normalize-space()='価格(万円)']/following::input[2]" },
        { "by": "name", "value": "priceHigh" },
        { "by": "name", "value": "priceMax" }
      ] },

    { "id": "click_search", "description": "「検索」ボタン（右下・緑）をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "検索", "options": { "role": "button" } }, { "by": "text", "value": "検索する" }, { "by": "text", "value": "検索" }, { "by": "css", "value": "button[type='submit']" } ],
      "note": "色や位置ではなくボタン名で特定します。名称が違えばtargetsを調整。" },
    { "id": "wait_results", "description": "検索結果の表示を待つ", "action": "wait_ms", "value": 3000 },
    { "id": "dump_results", "description": "（診断）結果画面のHTMLを保存", "action": "dump_html", "optional": true },
    { "id": "select_all_in_page", "description": "「ページ内全選択」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "ページ内全選択", "options": { "role": "button" } }, { "by": "text", "value": "ページ内全選択" }, { "by": "text", "value": "全選択" } ] },
    { "id": "click_zumen_ikkatsu", "description": "「図面の一括取得」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "図面一括取得", "options": { "role": "button" } }, { "by": "text", "value": "図面の一括取得" }, { "by": "text", "value": "図面一括取得" } ] },
    { "id": "wait_dialog", "description": "確認ポップアップの表示を待つ", "action": "wait_ms", "value": 1500 },
    { "id": "dialog_ikkatsu", "description": "出てきたポップアップ内の「一括取得」をクリック", "action": "click",
      "targets": [
        { "by": "css", "value": ".modal.show button:text-is('一括取得')" },
        { "by": "css", "value": ".modal.show >> text=一括取得" },
        { "by": "role", "value": "一括取得", "options": { "role": "button", "exact": true } },
        { "by": "text", "value": "一括取得", "options": { "exact": true } }
      ],
      "note": "背後の『図面一括取得』ではなく、ポップアップ(.modal.show)内の『一括取得』を厳密一致(text-is)で狙う。ダウンロードはトップの downloads フォルダに保存されます。" },
    { "id": "wait_download", "description": "図面ダウンロードの完了を待つ（時間は必要に応じて調整）", "action": "wait_ms", "value": 30000 }
  ]
}
