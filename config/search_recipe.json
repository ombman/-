{
  "_readme": [
    "このファイルは『売買物件検索』の自動操作手順です。プログラムを書き換えずに、",
    "ここ（JSON）を編集するだけで手順や特定条件を調整できます。",
    "",
    "各ステップの意味:",
    "  id                : ステップの識別名（スクショのファイル名にも使われます）",
    "  description       : 何をするかの説明（ログに出ます）",
    "  action            : 操作の種類。click / fill / select / choose / check / scroll /",
    "                      wait_for / wait_ms / verify / screenshot",
    "                      ※choose = プルダウンでもクリック式リストでも選べる万能選択",
    "  targets           : 対象の特定候補。上から順に試し、最初に見つかったものを使います。",
    "                      by = label / role / text / placeholder / name / id / css / xpath",
    "  value             : fill(入力) / select / choose で使う値",
    "  verify            : 操作後の確認条件（contains / visible_targets / not_contains）",
    "  scroll_into_view  : true にすると対象が画面内に来るまでスクロールします",
    "  coordinate_fallback : [x, y]。HTMLで特定できない時だけ使う座標（補助手段）",
    "",
    "★重要: REINSの実際のHTML要素名（id/name）は環境で異なる可能性があります。",
    "  まず『見える日本語ラベル・ボタン名(by=text / label / role)』が当たりやすいです。",
    "  当たらない場合は logs/shots の画像を見ながら targets を足す/直してください。",
    "  『python tools/inspect.py』で実画面の要素名を調べられます。",
    "",
    "★要確認（実在情報と食い違う指示があった箇所。実画面で確認してください）:",
    "  1) 沿線3の終駅: ご指示は『香露園』でしたが、阪神本線の実在駅は『香櫨園(こうろえん)』。",
    "     香櫨園 を主候補、香露園 を予備候補にしています。違えば targets を修正。",
    "  2) 沿線3の行選択: 阪神本線＝『は行』でユーザー確定済み。verify で阪神本線の出現も確認します。"
  ],

  "steps": [
    { "id": "open_baibai_search",
      "description": "「売買物件検索」を探してクリックする",
      "action": "click",
      "targets": [
        { "by": "role", "value": "売買物件検索", "options": { "role": "link" } },
        { "by": "text", "value": "売買物件検索" }
      ],
      "verify": { "contains": "物件種別" }
    },
    { "id": "select_bukken_shubetsu1_baimansion",
      "description": "「物件種別1」から「売マンション」を選択する",
      "action": "choose",
      "value": "売マンション",
      "targets": [
        { "by": "label", "value": "物件種別1" },
        { "by": "name", "value": "bukkenShubetsu1" },
        { "by": "css", "value": "select[name*='shubetsu']" }
      ],
      "note": "choose=プルダウンでもクリック式（チェック/ボタン）でも選べる。",
      "verify": { "contains": "売マンション" }
    },

    { "id": "scroll_to_ensen1", "description": "「沿線1」まで下方向にスクロール", "action": "scroll", "value": 700 },
    { "id": "ensen1_open_guide",
      "description": "「沿線1」の「入力ガイド」をクリック",
      "action": "click", "scroll_into_view": true,
      "targets": [ { "by": "css", "value": "text=入力ガイド >> nth=0" }, { "by": "text", "value": "入力ガイド" } ],
      "note": "沿線1は先頭(nth=0)の入力ガイド。ずれる場合は nth を調整。",
      "verify": { "contains": "近畿圏" }
    },
    { "id": "ensen1_kinki", "description": "「近畿圏」を選択", "action": "click",
      "targets": [ { "by": "role", "value": "近畿圏", "options": { "role": "button" } }, { "by": "text", "value": "近畿圏" } ] },
    { "id": "ensen1_hyogo", "description": "「兵庫県」を選択", "action": "click",
      "targets": [ { "by": "role", "value": "兵庫県", "options": { "role": "button" } }, { "by": "text", "value": "兵庫県" } ] },
    { "id": "ensen1_next_1", "description": "「次へ」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "次へ", "options": { "role": "button" } }, { "by": "text", "value": "次へ" } ] },
    { "id": "ensen1_ta_row", "description": "「た行」を選択（東海道線＝『と』はた行）", "action": "click",
      "targets": [ { "by": "text", "value": "た行" }, { "by": "text", "value": "た" } ],
      "verify": { "contains": "東海道線" } },
    { "id": "ensen1_tokaido", "description": "「東海道線」を選択", "action": "click",
      "targets": [ { "by": "text", "value": "東海道線" } ] },
    { "id": "ensen1_next_2", "description": "「次へ」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "次へ", "options": { "role": "button" } }, { "by": "text", "value": "次へ" } ],
      "verify": { "contains": "甲子園口" } },
    { "id": "ensen1_start", "description": "始駅「甲子園口」を選択", "action": "choose", "value": "甲子園口",
      "targets": [ { "by": "label", "value": "始駅" }, { "by": "name", "value": "startStation1" } ] },
    { "id": "ensen1_end", "description": "終駅「さくら夙川」を選択", "action": "choose", "value": "さくら夙川",
      "targets": [ { "by": "label", "value": "終駅" }, { "by": "name", "value": "endStation1" } ] },
    { "id": "ensen1_decide", "description": "「決定」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "決定", "options": { "role": "button" } }, { "by": "text", "value": "決定" } ] },
    { "id": "ensen1_verify", "description": "沿線1（東海道線）が反映されたか確認", "action": "verify",
      "verify": { "contains": "東海道線" } },
    { "id": "ensen1_walk_min", "description": "駅から徒歩に 10 を入力", "action": "fill", "value": "10",
      "targets": [ { "by": "label", "value": "駅から徒歩" }, { "by": "name", "value": "walkMinutes1" }, { "by": "css", "value": "input[name*='walk']" } ] },
    { "id": "ensen1_walk_unit", "description": "駅から徒歩の単位で「分」を選択", "action": "choose", "value": "分",
      "targets": [ { "by": "label", "value": "単位" }, { "by": "name", "value": "walkUnit1" } ],
      "note": "単位が固定表示なら本ステップは削除可。プルダウンでなければ action:choose に変更。" },

    { "id": "scroll_to_ensen2", "description": "「沿線2」まで下方向にスクロール", "action": "scroll", "value": 500 },
    { "id": "ensen2_open_guide",
      "description": "「沿線2」の「入力ガイド」をクリック",
      "action": "click", "scroll_into_view": true,
      "targets": [ { "by": "css", "value": "text=入力ガイド >> nth=1" }, { "by": "text", "value": "入力ガイド" } ],
      "note": "沿線2は2番目(nth=1)の入力ガイド。ずれる場合は数字を調整。",
      "verify": { "contains": "近畿圏" }
    },
    { "id": "ensen2_kinki", "description": "「近畿圏」を選択", "action": "click",
      "targets": [ { "by": "role", "value": "近畿圏", "options": { "role": "button" } }, { "by": "text", "value": "近畿圏" } ] },
    { "id": "ensen2_hyogo", "description": "「兵庫県」を選択", "action": "click",
      "targets": [ { "by": "role", "value": "兵庫県", "options": { "role": "button" } }, { "by": "text", "value": "兵庫県" } ] },
    { "id": "ensen2_next_1", "description": "「次へ」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "次へ", "options": { "role": "button" } }, { "by": "text", "value": "次へ" } ] },
    { "id": "ensen2_ha_row", "description": "「は行」を選択（阪急神戸線＝『は』）", "action": "click",
      "targets": [ { "by": "text", "value": "は行" }, { "by": "text", "value": "は" } ],
      "verify": { "contains": "阪急神戸線" } },
    { "id": "ensen2_hankyu_kobe", "description": "「阪急神戸線」を選択", "action": "click",
      "targets": [ { "by": "text", "value": "阪急神戸線" } ] },
    { "id": "ensen2_next_2", "description": "「次へ」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "次へ", "options": { "role": "button" } }, { "by": "text", "value": "次へ" } ],
      "verify": { "contains": "西宮北口" } },
    { "id": "ensen2_start", "description": "始駅「西宮北口」を選択", "action": "choose", "value": "西宮北口",
      "targets": [ { "by": "label", "value": "始駅" }, { "by": "name", "value": "startStation2" } ],
      "note": "『西宮北口』を一部に含む別駅は無いため部分一致の心配は無し。chooseは完全一致を優先します。" },
    { "id": "ensen2_end", "description": "終駅「夙川」を選択", "action": "choose", "value": "夙川",
      "targets": [ { "by": "label", "value": "終駅" }, { "by": "name", "value": "endStation2" } ],
      "note": "『夙川』は『さくら夙川』と部分一致し得ます。exact一致を優先しています。" },
    { "id": "ensen2_decide", "description": "「決定」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "決定", "options": { "role": "button" } }, { "by": "text", "value": "決定" } ] },
    { "id": "ensen2_verify", "description": "沿線2（阪急神戸線）が反映されたか確認", "action": "verify",
      "verify": { "contains": "阪急神戸線" } },
    { "id": "ensen2_walk_min", "description": "駅から徒歩に 10 を入力", "action": "fill", "value": "10",
      "targets": [ { "by": "name", "value": "walkMinutes2" }, { "by": "label", "value": "駅から徒歩" }, { "by": "css", "value": "input[name*='walk']" } ] },
    { "id": "ensen2_walk_unit", "description": "駅から徒歩の単位で「分」を選択", "action": "choose", "value": "分",
      "targets": [ { "by": "name", "value": "walkUnit2" }, { "by": "label", "value": "単位" } ],
      "note": "プルダウンでなければ action:choose に変更。" },

    { "id": "scroll_to_ensen3", "description": "「沿線3」まで下方向にスクロール", "action": "scroll", "value": 500 },
    { "id": "ensen3_open_guide",
      "description": "「沿線3」の「入力ガイド」をクリック",
      "action": "click", "scroll_into_view": true,
      "targets": [ { "by": "css", "value": "text=入力ガイド >> nth=2" }, { "by": "text", "value": "入力ガイド" } ],
      "note": "沿線3は3番目(nth=2)の入力ガイド。ずれる場合は数字を調整。",
      "verify": { "contains": "近畿圏" }
    },
    { "id": "ensen3_kinki", "description": "「近畿圏」を選択", "action": "click",
      "targets": [ { "by": "role", "value": "近畿圏", "options": { "role": "button" } }, { "by": "text", "value": "近畿圏" } ] },
    { "id": "ensen3_hyogo", "description": "「兵庫県」を選択", "action": "click",
      "targets": [ { "by": "role", "value": "兵庫県", "options": { "role": "button" } }, { "by": "text", "value": "兵庫県" } ] },
    { "id": "ensen3_next_1", "description": "「次へ」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "次へ", "options": { "role": "button" } }, { "by": "text", "value": "次へ" } ] },
    { "id": "ensen3_ha_row",
      "description": "「は行」を選択（阪神本線＝『は』。ユーザー確定）",
      "action": "click",
      "targets": [ { "by": "text", "value": "は行" }, { "by": "text", "value": "は" } ],
      "note": "verifyで阪神本線が見つからなければ、実画面の行表記を inspect.py で確認して調整してください。",
      "verify": { "contains": "阪神本線" } },
    { "id": "ensen3_hanshin", "description": "「阪神本線」を選択", "action": "click",
      "targets": [ { "by": "text", "value": "阪神本線" } ] },
    { "id": "ensen3_next_2", "description": "「次へ」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "次へ", "options": { "role": "button" } }, { "by": "text", "value": "次へ" } ],
      "verify": { "contains": "甲子園" } },
    { "id": "ensen3_start", "description": "始駅「甲子園」を選択", "action": "choose", "value": "甲子園",
      "targets": [ { "by": "label", "value": "始駅" }, { "by": "name", "value": "startStation3" } ],
      "note": "『甲子園』は『甲子園口』と部分一致し得ます。exact一致を優先しています。" },
    { "id": "ensen3_end",
      "description": "終駅「香櫨園」を選択（ご指示『香露園』は実在駅『香櫨園』と解釈）",
      "action": "choose", "value": "香櫨園",
      "targets": [ { "by": "label", "value": "終駅" }, { "by": "name", "value": "endStation3" } ],
      "note": "実画面の表記が『香露園』ならvalueをそれに変更してください。" },
    { "id": "ensen3_decide", "description": "「決定」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "決定", "options": { "role": "button" } }, { "by": "text", "value": "決定" } ] },
    { "id": "ensen3_verify", "description": "沿線3（阪神本線）が反映されたか確認", "action": "verify",
      "verify": { "contains": "阪神本線" } },
    { "id": "ensen3_walk_min", "description": "駅から徒歩に 10 を入力", "action": "fill", "value": "10",
      "targets": [ { "by": "name", "value": "walkMinutes3" }, { "by": "label", "value": "駅から徒歩" }, { "by": "css", "value": "input[name*='walk']" } ] },
    { "id": "ensen3_walk_unit", "description": "駅から徒歩の単位で「分」を選択", "action": "choose", "value": "分",
      "targets": [ { "by": "name", "value": "walkUnit3" }, { "by": "label", "value": "単位" } ],
      "note": "プルダウンでなければ action:choose に変更。" },

    { "id": "scroll_to_price", "description": "価格欄まで下方向にスクロール", "action": "scroll", "value": 500 },
    { "id": "price_min", "description": "価格の下限に 3000（万円）を入力", "action": "fill", "value": "3000",
      "scroll_into_view": true,
      "targets": [ { "by": "name", "value": "priceLow" }, { "by": "name", "value": "priceMin" }, { "by": "css", "value": "input[name*='price']:nth-of-type(1)" } ],
      "note": "価格欄は下限/上限の2つ。実際のname/idを inspect.py で確認して調整してください。単位が万円か円かも要確認。" },
    { "id": "price_max", "description": "価格の上限に 7000（万円）を入力", "action": "fill", "value": "7000",
      "targets": [ { "by": "name", "value": "priceHigh" }, { "by": "name", "value": "priceMax" }, { "by": "css", "value": "input[name*='price']:nth-of-type(2)" } ],
      "note": "上限側のname/idを inspect.py で確認して調整してください。" },

    { "id": "click_search", "description": "「検索」ボタン（右下・緑）をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "検索", "options": { "role": "button" } }, { "by": "text", "value": "検索する" }, { "by": "text", "value": "検索" }, { "by": "css", "value": "button[type='submit']" } ],
      "note": "色や位置ではなくボタン名で特定します。名称が違えばtargetsを調整。",
      "verify": { "contains": "件" } },
    { "id": "wait_results", "description": "検索結果の表示を待つ", "action": "wait_ms", "value": 2000 },
    { "id": "select_all_in_page", "description": "「ページ内全選択」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "ページ内全選択", "options": { "role": "button" } }, { "by": "text", "value": "ページ内全選択" }, { "by": "text", "value": "全選択" } ] },
    { "id": "click_zumen_ikkatsu", "description": "「図面の一括取得」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "図面の一括取得", "options": { "role": "button" } }, { "by": "text", "value": "図面の一括取得" }, { "by": "text", "value": "図面一括取得" } ] },
    { "id": "dialog_ikkatsu", "description": "出てきた画面の「一括取得」をクリック", "action": "click",
      "targets": [ { "by": "role", "value": "一括取得", "options": { "role": "button" } }, { "by": "text", "value": "一括取得" } ],
      "note": "確認ダイアログ内の一括取得ボタン。ダウンロードはトップの downloads フォルダに保存されます。" },
    { "id": "wait_download", "description": "図面ダウンロードの完了を待つ（時間は必要に応じて調整）", "action": "wait_ms", "value": 20000 }
  ]
}
